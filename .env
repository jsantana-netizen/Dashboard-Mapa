# Configuración del Dashboard Mapa
# Intervalo de polling: 24 horas = 86,400,000 milisegundos
VITE_POLL_INTERVAL_MS=86400000

# URL del webhook de N8N - Webhook path: "Dashboard Mapa"
# La instancia de N8N está en: jsereno.app.n8n.cloud
VITE_WEBHOOK_URL=https://jsereno.app.n8n.cloud/webhook/Dashboard%20Mapa

# Umbral para marcar datos como obsoletos (5 minutos)
VITE_STALE_THRESHOLD_MS=300000
